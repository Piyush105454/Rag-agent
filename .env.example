# .env.example
# Copy this file to .env and fill in real values before running the stack.
# Never commit the actual .env file to source control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rag:rag_secret@postgres:5432/rag_db

# ── Embedding Model ───────────────────────────────────────────────────────────
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DEVICE=cpu

# ── Reranker Model ────────────────────────────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-base

# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Google Drive Sync ─────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=/app/secrets/service_account.json
DRIVE_FOLDER_ID=
DRIVE_POLL_INTERVAL_MINUTES=15

# ── Local Docs ────────────────────────────────────────────────────────────────
LOCAL_DOCS_PATH=/app/local_docs

# ── MCP Server ────────────────────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8001

# ── Retrieval Tuning ─────────────────────────────────────────────────────────
TOP_K_RETRIEVAL=20
TOP_K_RERANKED=5
CONFIDENCE_THRESHOLD=0.4

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
